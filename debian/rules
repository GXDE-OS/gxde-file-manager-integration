#!/usr/bin/make -f
include /usr/share/dpkg/default.mk

VERSION=$(shell dpkg-parsechangelog -ldebian/changelog -SVersion | awk -F'-' '{print $$1}')
DEB_BUILD_ARCH ?= $(shell dpkg-architecture -qDEB_BUILD_ARCH)
%:
	dh $@ --parallel --buildsystem=qmake6

override_dh_shlibdeps:
	dh_shlibdeps

override_dh_auto_configure:
	dh_auto_configure --buildsystem=qmake6 -- DAPP_VERSION=$(VERSION) LIB_INSTALL_DIR=/usr/lib/$(DEB_HOST_MULTIARCH)
